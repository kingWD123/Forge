# Remplir puis renommer en ".env".
# Authentification : gcloud auth application-default login

GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=<TON_PROJET_GCP>
GOOGLE_CLOUD_LOCATION=us-central1

MODEL_NAME=gemini-2.5-flash

# Dépôt sur lequel l'Atelier travaille (par défaut : le dossier courant)
FORGE_WORKSPACE=

# Autorisations : ask (défaut), auto-edit (écritures libres), auto (tout sauf l'interdit)
FORGE_PERMISSION_MODE=ask

# Compilateur de contexte : off (défaut, configuration A) ou on (configuration B)
FORGE_CONTEXT=off
